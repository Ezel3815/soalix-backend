// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  USER
}

enum DeckType {
  CARDS_DECK
  PACKAGE_DECK
}

enum CardType {
  BASIC
  CLOZE
  OCCLUSION
}

enum UserStatus {
  ACTIVE
  INACTIVE
  PENDING
}

enum MediaType {
  IMAGE
  PDF
}

model User {
  id                  Int          @id @default(autoincrement())
  email               String       @unique
  password            String
  name                String
  decks               UserDeck[]
  role                UserRole     @default(USER)
  session_code        String?
  activation_code     String?
  status              UserStatus   @default(PENDING)
  reset_password_code String?
  created_at          DateTime     @default(now())
  cards_answers       CardAnswer[]
}

model Deck {
  id         Int        @id @default(autoincrement())
  title      String
  cards      Card[]
  codes      CodeDeck[]
  users      UserDeck[]
  parent_id  Int?
  parent     Deck?      @relation(fields: [parent_id], references: [id], name: "deck-parent-child")
  children   Deck[]     @relation(name: "deck-parent-child")
  by_admin   Boolean    @default(false)
  type       DeckType   @default(CARDS_DECK)
  created_at DateTime   @default(now())
  public     Boolean    @default(false)
  order      Int        @default(0)
}

model Card {
  id                Int          @id @default(autoincrement())
  order             Int
  deck_id           Int
  deck              Deck         @relation(fields: [deck_id], references: [id])
  type              CardType
  data              Json
  document_name     String?      @unique
  document_title    String?
  front_image_name  String?      @unique
  back_image_name   String?      @unique
  created_at        DateTime     @default(now())
  front_image_media Media?       @relation(fields: [front_image_name], references: [name], name: "front_image_media")
  back_image_media  Media?       @relation(fields: [back_image_name], references: [name], name: "back_image_media")
  document_media    Media?       @relation(fields: [document_name], references: [name], name: "document_media")
  answers           CardAnswer[]
}

enum AnswerType {
  EASY
  GOOD
  HARD
  AGAIN
  NONE
}

model CardAnswer {
  user_id    Int
  card_id    Int
  answer     AnswerType
  user       User       @relation(fields: [user_id], references: [id])
  card       Card       @relation(fields: [card_id], references: [id])
  created_at DateTime   @default(now())
  updated_at DateTime   @default(now())

  @@id([user_id, card_id])
}

model Code {
  id         Int      @id @default(autoincrement())
  code       String   @unique @default(uuid())
  created_at DateTime @default(now())

  decks CodeDeck[]
}

model CodeDeck {
  code_id Int
  deck_id Int

  code Code @relation(fields: [code_id], references: [id])
  deck Deck @relation(fields: [deck_id], references: [id])

  @@id([code_id, deck_id])
}

model UserDeck {
  user_id           Int
  deck_id           Int
  user              User     @relation(fields: [user_id], references: [id])
  deck              Deck     @relation(fields: [deck_id], references: [id])
  editable          Boolean
  sharable          Boolean
  created_at        DateTime @default(now())
  share_code        String?  @unique
  share_is_editable Boolean?
  share_is_sharable Boolean?

  @@id([user_id, deck_id])
}

model Media {
  name          String    @id
  type          MediaType
  front_card    Card?     @relation(name: "front_image_media")
  back_card     Card?     @relation(name: "back_image_media")
  document_card Card?     @relation(name: "document_media")
  created_at    DateTime  @default(now())
}
